MONGODB_URI=
MONGODB_DB_NAME=ozama-chess
JWT_SECRET=usa_un_valor_largo_aleatorio_de_32_caracteres_o_mas
ADMIN_EMAILS=
APP_ORIGINS=https://ozama-chess.onrender.com
NODE_ENV=development
PORT=3000

# Google Sign-In (opcional -- si se dejan vacias, el boton de Google
# simplemente no aparece, el resto de la app funciona igual)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# reCAPTCHA v3 Enterprise en el registro (opcional -- si se deja vacio
# RECAPTCHA_SECRET_KEY, el registro no lo exige)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# PayPal Subscriptions -- OZAMA Premium (opcional -- si falta cualquiera
# de estas, el boton de Premium se oculta solo, ver services/paypal.js)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
