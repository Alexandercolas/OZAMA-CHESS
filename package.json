{
  "name": "ozama-chess",
  "version": "1.0.0",
  "description": "OZAMA CHESS - Online Multiplayer Chess",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js",
    "verify": "node scripts/verify.js",
    "check": "npm run verify && npm test",
    "mobile:sync": "npx cap sync android",
    "mobile:open": "npx cap open android",
    "android:build:debug": "node scripts/android-build.js debug",
    "android:build:release": "node scripts/android-build.js release",
    "android:build:signed": "node scripts/android-build.js signed",
    "android:install:debug": "node scripts/android-install.js"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.3",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "nodemon": "^3.1.14"
  }
}
